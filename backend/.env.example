# Copy this file to .env and fill in real values.

APP_NAME=KinnowERP API
ENV=development

# PostgreSQL connection string
# Format: postgresql+pg8000://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/kinonow_erp

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins, or "*" for dev.
# For the packaged Android WebView app, add: file://
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Twilio (WhatsApp order-assignment notifications) — used only by
# app/db/init_db.py to seed company_settings. Get these from your Twilio
# Console (console.twilio.com) — never commit real values to source control.
TWILIO_SID=
TWILIO_TOKEN=
